        <mxCell id="Ru1K344zEqCTEf8AWoHn-41" parent="1" style="text;html=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#1F2A44;" value="= satu atau banyak" vertex="1">
          <mxGeometry height="24" width="130" x="1526" y="1029" as="geometry" />
        </mxCell>
        <mxCell id="Ru1K344zEqCTEf8AWoHn-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;p&gt;&lt;strong&gt;Catatan:&lt;/strong&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;FK gabungan merupakan kombinasi dua atribut &lt;em&gt;Foreign Key&lt;/em&gt; (FK), yaitu &lt;code dir=&quot;ltr&quot;&gt;id_peminjaman&lt;/code&gt; dan &lt;code dir=&quot;ltr&quot;&gt;id_eksemplar&lt;/code&gt;, yang secara bersama-sama merujuk pada &lt;em&gt;Primary Key&lt;/em&gt; (PK) gabungan pada entitas &lt;code dir=&quot;ltr&quot;&gt;Detail_Peminjaman&lt;/code&gt;.&lt;/p&gt;&lt;p&gt;Setiap transaksi peminjaman dapat mencakup maksimal 10 eksemplar buku sesuai aturan bisnis perpustakaan.&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="867" x="173" y="884" as="geometry" />
        </mxCell>
        <mxCell id="fqN2YG-fH5j9VstqnLwp-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7DEE8;strokeWidth=0.6;" value="" vertex="1">
          <mxGeometry height="25" width="285" x="613" y="814" as="geometry" />
        </mxCell>
        <mxCell id="fqN2YG-fH5j9VstqnLwp-3" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#253449;spacingLeft=2;" value="lokasi_eksemplar" vertex="1">
          <mxGeometry height="23" width="268" x="662" y="813" as="geometry" />
        </mxCell>
        <mxCell id="dTnmlDcFwJM0VZ0qaqSo-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;p&gt;&lt;strong&gt;Umpan Balik :&lt;/strong&gt;&amp;nbsp;&lt;/p&gt;&lt;h3&gt;Umpan Balik 1 — Danang Setiawan&lt;/h3&gt;&lt;p&gt;Menurut saya, desain ERD yang dibuat sudah cukup jelas karena entitas dan atributnya disusun dengan rapi. Hubungan antara entitas juga sudah membantu menjelaskan proses peminjaman dan pengembalian buku di perpustakaan. Saran saya, ukuran tulisan dan jarak ant entitas tetap diperhatikan agar diagram lebih mudah dibaca.&lt;/p&gt;&lt;h3&gt;Umpan Balik 2 — Abbiyu Hashfi Dzakwhan&lt;/h3&gt;&lt;p&gt;Menurut saya, ERD yang dibuat sudah menggambarkan kebutuhan sistem perpustakaan dengan cukup baik. Entitas seperti Anggota, Buku, Eksemplar, Peminjaman, dan Pengembalian sudah sesuai dengan proses yang ada. Saran saya, penamaan relasi dan simbol kardinalitas dibuat konsisten supaya hubungan antarentitas lebih mudah dipahami.&lt;/p&gt;" vertex="1">
          <mxGeometry height="201" width="1286" x="173" y="1140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
