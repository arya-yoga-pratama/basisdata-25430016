        <mxCell id="Ru1K344zEqCTEf8AWoHn-40" parent="1" style="text;html=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacing=0;fontFamily=Helvetica;fontSize=13;fontColor=#0B2A6B;" value="1..N" vertex="1">
